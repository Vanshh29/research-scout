# Copy to .env and fill in. Never commit .env.
SCOUT_DB_PATH=data/scout.db
SCOUT_LOG_LEVEL=INFO

# Day 2: GitHub personal access token (read-only, public repos) for API rate limits
GITHUB_TOKEN=

# Day 3: LLM provider ("gemini" | "anthropic" | "fake")
SCOUT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Day 3: Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: POST the daily brief JSON to an n8n webhook (ADR-009)
SCOUT_N8N_WEBHOOK_URL=
